# Optional DeepSeek bootstrap configuration. You can also configure DeepSeek or
# OpenAI-compatible models from Settings > Model Configuration in the Web UI.
# A configuration saved in the UI takes precedence over these defaults.
DEEPSEEK_API_KEY=

# Maximum tokens generated per model call (1–16384); keep modest for a Demo.
DEEPSEEK_MAX_TOKENS=1024
# Optional retry count: DEEPSEEK_MAX_RETRIES=1 (allowed 0–3).

# Optional: DeepSeek proxy endpoint or isolated test-provider fixture.
# Initial model is deepseek-flash; the UI can select a different model and URL.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional initial default workspace. Defaults to <project>/agent-files.
# Settings > Workspace Directory overrides this after saving. Project chats use
# their selected project directory; /workspace/ always means the current root.
# Keep credentials and application databases outside working directories.
# WORKSPACE_FILES_DIR=/absolute/path/to/agent-files
