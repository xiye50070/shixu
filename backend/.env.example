# Only DeepSeek is supported. Configure your own key, then restart the backend.
DEEPSEEK_API_KEY=

# Maximum tokens generated per model call (1–16384); keep modest for a Demo.
DEEPSEEK_MAX_TOKENS=1024
# Optional retry count: DEEPSEEK_MAX_RETRIES=1 (allowed 0–3).

# Optional: DeepSeek proxy endpoint or isolated test-provider fixture.
# The model stays fixed as deepseek-flash. Leave this at the official default.
DEEPSEEK_BASE_URL=https://api.deepseek.com
